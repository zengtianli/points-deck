    pc = sub.add_parser("config", help="当前家庭的规则/奖励/档位配置", description="当前家庭的规则/奖励/档位配置")
    csub = pc.add_subparsers(dest="sub", metavar="动作", required=True)
    p = csub.add_parser("get", help="读当前生效的配置")
    p.add_argument("--json", action="store_true")
    p.add_argument("--parent-stdin", action="store_true")
    p.set_defaults(fn=cmd_config_get)
    p = csub.add_parser("put", help="整段替换一类配置（服务端整体校验，不过就一个字不写）")
    p.add_argument("kind", choices=CONFIG_KINDS)
    p.add_argument("--revision", help="编辑时读取的配置版本")
    p.add_argument("--file", required=True, help="JSON 数组文件（或 {\"items\": [...]}）")
    p.add_argument("--json", action="store_true")
    p.add_argument("--parent-stdin", action="store_true")
    p.set_defaults(fn=cmd_config_put)

    p = cmd("profile", cmd_profile, "改昵称/预设头像/上传头像（不要家长密码）")
    p.add_argument("--nick", help="昵称（1~16 字）")
    p.add_argument("--emoji", help="预设头像（state 里的 avatars 之一）")
    p.add_argument("--avatar-file", help="上传头像图片（png/jpeg/webp，≤200KB）")

    pa = sub.add_parser("account", help="账号：邮件验证 / 注册 / 绑定 / 改密 / 找回 / 注销", description="账号：邮件验证 / 注册 / 绑定 / 改密 / 找回 / 注销")
    asub = pa.add_subparsers(dest="sub", metavar="动作", required=True)
    for name, fn, h in (("passwd", cmd_account_passwd, "改登录密码（当前密码；新密码从 stdin）"),):
        p = asub.add_parser(name, help=h, description=h)
        p.add_argument("--json", action="store_true")
        p.add_argument("--new-stdin", action="store_true", help="新密码从 stdin 读（必需）")
        p.set_defaults(fn=fn)
    for name in ("code-send", "code-verify", "register", "recover", "email-bind"):
        p = asub.add_parser(name, help="共享账号接口；验证码与授权只从 stdin 读")
        p.add_argument("--json", action="store_true")
        p.set_defaults(fn=cmd_account_security, login=name == "email-bind")
        if name in ("code-send", "register", "email-bind"): p.add_argument("--email", required=True)
        if name == "code-send": p.add_argument("--purpose", required=True, choices=("register", "recover", "email_new", "email_old"))
        if name == "code-verify": p.add_argument("--challenge", required=True)
        if name == "register": p.add_argument("--nick")
        if name in ("register", "recover"): p.add_argument("--new-stdin", action="store_true", required=True)
        if name == "email-bind": p.add_argument("--old-grant-stdin", action="store_true")
    p = asub.add_parser("delete", help="注销本账号（不可恢复，须 --yes）")
    p.add_argument("--yes", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_account_delete)
    p = asub.add_parser("delete-request", help="即时注销被拒（409，账号还连着共享资料）时递注销申请（不可撤回，须 --yes）")
    p.add_argument("--yes", action="store_true")
    p.add_argument("--identity-grant-stdin", action="store_true", help="未设密码的手机账号：用当前手机身份授权代替密码")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_account_delete_request)
    p = asub.add_parser("delete-status", help="注销进度（只读）：给 --receipt 不用登录，不给则查当前账号")
    p.add_argument("--receipt", help="注销回执 id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_account_delete_status)

    for name in ("phone-send", "phone-verify", "phone-register", "phone-login", "phone-bind", "phone-recover", "password-set"):
        p = asub.add_parser(name, help="手机账号接口；OTP/授权只从 stdin 读，短信结果不冒充实际收信")
        p.add_argument("--json", action="store_true")
        p.set_defaults(fn=cmd_phone_security, login=name in ("phone-bind", "password-set"))
        if name in ("phone-send", "phone-bind"): p.add_argument("--phone", required=True)
        if name == "phone-send":
            p.add_argument("--purpose", required=True, choices=("register", "login", "phone_new", "phone_change_new", "phone_old", "phone_identity", "phone_recover"))
            p.add_argument("--request-id")
        if name == "phone-verify": p.add_argument("--challenge", required=True)
        if name == "phone-register": p.add_argument("--agree", action="store_true", required=True)
        if name in ("phone-bind", "phone-send", "password-set"): p.add_argument("--identity-grant-stdin", action="store_true")
        if name == "phone-bind": p.add_argument("--old-grant-stdin", action="store_true")
        if name in ("phone-recover", "password-set"): p.add_argument("--new-stdin", action="store_true", required=True)
        if name in ("phone-login", "phone-recover"):
            p.add_argument("--risk-password-stdin", action="store_true")
            p.add_argument("--risk-email-grant-stdin", action="store_true")

    pu = sub.add_parser("users", help="站点用户管理（须显式管理员身份及独立运维密码）",
                        description="站点用户管理（须显式管理员身份及独立运维密码）")
    usub = pu.add_subparsers(dest="sub", metavar="动作", required=True)
    p = usub.add_parser("list", help="列账号与余额")
    p.set_defaults(fn=cmd_users_list)
    p = usub.add_parser("reset-password", help="重置一个账号的密码（新密码从 stdin）")
    p.add_argument("target", help="用户名")
    p.add_argument("--new-stdin", action="store_true", help="新密码从 stdin 读（必需）")
    p.set_defaults(fn=cmd_users_reset)
    p = usub.add_parser("delete", help="删除一个账号（挪进服务器 trash/，须 --yes）")
    p.add_argument("target", help="用户名")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(fn=cmd_users_delete)
    for p in (usub.choices["list"], usub.choices["reset-password"], usub.choices["delete"]):
        p.add_argument("--json", action="store_true")
        p.add_argument("--parent-stdin", action="store_true")
    return ap


def main(argv: list[str]) -> int:
    ap = build()
    a = ap.parse_args(argv)
    if not getattr(a, "fn", None):
        ap.print_help()
        return 2
    as_json = getattr(a, "json", False)
    sec = Secrets(a)
    try:
        if a.fn is cmd_account_delete_status and a.receipt:
            a.login = False                         # 凭回执查：同登录页入口，不要凭据
        needs_login = (getattr(a, "login", True) or (getattr(a, "sub", None) == "code-send" and a.purpose.startswith("email_"))
                       or (getattr(a, "sub", None) == "phone-send" and a.purpose.startswith("phone_") and a.purpose != "phone_recover"))
        if a.phone_grant_stdin:
            c = client(a); c.call("api/phone_login", {"grant": sec._line("短信登录授权")})
        else:
            c = session(a, sec) if needs_login else client(a)
        v, text = a.fn(c, a, sec)
    except Fail as f:
        return report_fail(f, as_json)
    except OSError as e:
        return report_fail(Fail(f"读写本地文件失败：{e}"), as_json)
    if as_json:
        print(json.dumps(v, ensure_ascii=False, indent=1))
    else:
        print(text())
    return 0


def report_fail(f: Fail, as_json: bool) -> int:
    if as_json:
        print(json.dumps(fail_json(f.msg, f.code, f.status), ensure_ascii=False))
    else:
        print(f"✘ {f.msg}", file=sys.stderr)
    return f.code


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
