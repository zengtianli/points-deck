def cmd_account_security(c, a, sec):
    if a.sub == "code-send":
        value = c.call("api/email_send", {"email": a.email, "purpose": a.purpose,
                                         "password": sec.account() if a.purpose.startswith("email_") else ""})
    elif a.sub == "code-verify":
        value = c.call("api/email_verify", {"challenge": a.challenge, "code": sec._line("验证码")})
    elif a.sub == "register":
        value = c.call("api/register", {"email": a.email, "p": sec.new(), "nick": a.nick or "", "grant": sec._line("注册授权")})
    elif a.sub == "recover":
        value = c.call("api/recover", {"new": sec.new(), "grant": sec._line("找回授权")})
    else:
        value = c.call("api/email_bind", {"email": a.email, "password": sec.account(), "grant": sec._line("新邮箱授权"),
                                         "old_grant": sec._line("旧邮箱授权") if a.old_grant_stdin else ""})
    return value, lambda: json.dumps(value, ensure_ascii=False)


def cmd_phone_security(c, a, sec):
    identity = sec._line("当前手机身份授权") if getattr(a, "identity_grant_stdin", False) else ""
    if a.sub == "phone-send":
        rid = a.request_id or uuid.uuid4().hex
        body = {"phone": a.phone, "purpose": a.purpose, "request_id": rid, "identity_grant": identity,
                "password": sec.account() if a.purpose in ("phone_new", "phone_change_new", "phone_old") and not identity else ""}
        try:
            value = c.call("api/phone_send", body)
        except Fail as exc:
            raise Fail(f"{exc}；发送标识 {rid}。超时不自动重发；复用该标识核对，60秒后才主动新发", code=exc.code, status=exc.status) from exc
    elif a.sub == "phone-verify":
        value = c.call("api/phone_verify", {"challenge": a.challenge, "code": sec._line("短信验证码")})
    else:
        body = {"identity_grant": identity}
        if a.sub in ("phone-register", "phone-login", "phone-recover", "phone-bind"):
            body["grant"] = sec._line("对应用途手机授权")
        if a.sub == "phone-register":
            body["agreed"] = a.agree
        elif a.sub in ("phone-recover", "password-set"):
            body["new"] = sec.new()
        elif a.sub == "phone-bind":
            body.update(phone=a.phone, password=sec.account() if not identity else "",
                        old_grant=sec._line("原手机授权") if a.old_grant_stdin else "")
        if getattr(a, "risk_password_stdin", False): body["password"] = sec._line("独立原密码")
        if getattr(a, "risk_email_grant_stdin", False): body["email_grant"] = sec._line("独立邮箱授权")
        value = c.call("api/" + a.sub.replace("-", "_"), body)
    return value, lambda: json.dumps(value, ensure_ascii=False)


