 to set up an item with a name and points."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点右上角「新建」，设置自己的名称和积分。"}}}},"Terms of Use":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Terms of Use"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"用户协议"}}}},"The ledger could not complete this request (HTTP %lld).":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The ledger could not complete this request (HTTP %lld)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账本拒绝了这次请求（HTTP %lld）"}}}},"The ledger response is missing home details. Update the server and try again.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The ledger response is missing home details. Update the server and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账本没返回家园信息，请更新服务端后重试。"}}}},"The reward's cost or requirements have changed. Cancel and confirm again.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The reward's cost or requirements have changed. Cancel and confirm again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"奖励价格或条件已变化，请取消后重新确认。"}}}},"The server returned an unreadable response.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The server returned an unreadable response."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务端返回的不是 JSON"}}}},"This device does not keep a separate copy.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device does not keep a separate copy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机不存副本，所以不存在「两边不一样」这回事。"}}}},"This rule uses a formula. The formula is preserved. Edit its points in More Settings.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"This rule uses a formula. The formula is preserved. Edit its points in More Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这是参数型项目。原公式保留，分值请在「更多设置」中编辑。"}}}},"Threshold":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Threshold"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"门槛"}}}},"Tiers and Benefits":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tiers and Benefits"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"档位与待遇"}}}},"Tiers and Benefits: %@":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tiers and Benefits: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等级与待遇：%@"}}}},"Tiers and benefits":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tiers and benefits"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等级与待遇"}}}},"Trends":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Trends"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"走势"}}}},"Try Again":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try Again"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试"}}}},"Type":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"类型"}}}},"Undo":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Undo"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"撤销"}}}},"Undo this entry":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Undo this entry"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"撤销这笔误记"}}}},"Undone. Your ledger and trends have been restored.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Undone. Your ledger and trends have been restored."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已撤销，账本和走势已恢复"}}}},"Unlocks: %@":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlocks: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解锁 %@"}}}},"Use 15–128 characters, including spaces and Chinese characters. Choose a system-generated password or a unique passphrase.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use 15–128 characters, including spaces and Chinese characters. Choose a system-generated password or a unique passphrase."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"15–128 个字符，允许空格和中文。可使用系统生成密码或独特短语。"}}}},"Uses the saved snapshot from the shared keychain.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses the saved snapshot from the shared keychain."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据来自共享 keychain 仓里的真实快照"}}}},"Verified":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verified"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证完成"}}}},"Verified for Sign-In and Recovery":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verified for Sign-In and Recovery"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已验证，可用于登录和找回"}}}},"Verify Current Email":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify Current Email"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证原邮箱"}}}},"Verify Current Phone Number":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify Current Phone Number"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认原手机号"}}}},"Verify Email":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify Email"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证邮箱"}}}},"Verify New Phone Number":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify New Phone Number"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证新手机号"}}}},"Verify Phone Number":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify Phone Number"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证手机号"}}}},"Verify Your Identity":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify Your Identity"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新确认身份"}}}},"Verify your linked phone number to set a sign-in password. If you already have a password, use Change Password or Forgot Password.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify your linked phone number to set a sign-in password. If you already have a password, use Change Password or Forgot Password."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认当前绑定手机后设置独立登录密码。已有密码请使用修改或找回流程。"}}}},"View earlier entries":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"View earlier entries"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看更早流水"}}}},"Welcome to your new home!":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Welcome to your new home!"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"乔迁新居"}}}},"Whole number of points":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Whole number of points"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"整数分值"}}}},"Widget preview":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Widget preview"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Widget 视图预览"}}}},"Wisteria":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wisteria"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"紫藤"}}}},"You're at tier %lld · %@":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"You're at tier %lld · %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你在第 %1$lld 级 · %2$@"}}}},"You've moved into %@":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"You've moved into %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搬进「%@」了"}}}},"You've reached the highest tier!":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"You've reached the highest tier!"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已经住到顶了 —— 云端天堂"}}}},"You've reached the top tier — Cloud Paradise":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"You've reached the top tier — Cloud Paradise"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已经住到顶了 —— 云端天堂"}}}},"Your account and related data have been deleted.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your account and related data have been deleted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账号及相关数据清理已完成。"}}}},"Your account stores the parent’s phone number or email, a secure hash of any password you set, an optional nickname, point transactions, and family settings. Verification codes are used only for registration, sign-in, linking contact details, and recovery. We do not collect children’s phone numbers or identity documents. Never share your password or verification codes.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your account stores the parent’s phone number or email, a secure hash of any password you set, an optional nickname, point transactions, and family settings. Verification codes are used only for registration, sign-in, linking contact details, and recovery. We do not collect children’s phone numbers or identity documents. Never share your password or verification codes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账号保存家长本人手机号或邮箱、已设置密码的安全哈希、可选昵称、积分流水和家庭配置。验证码只用于注册、登录、绑定和恢复；不收集孩子手机号或身份资料。请勿向他人提供密码或验证码。"}}}},"Your balance and progress toward the next tier.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your balance and progress toward the next tier."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"总市值与「还差多少升级」"}}}},"Your edits are still here. Load the latest settings, review the merge, then save.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your edits are still here. Load the latest settings, review the merge, then save."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地编辑仍保留。读取最新配置后，确认合并再保存。"}}}},"Your email has been queued for delivery. Please check your inbox and spam folder.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your email has been queued for delivery. Please check your inbox and spam folder."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"邮件已提交投递，请检查收件箱和垃圾邮件。"}}}},"Your email is verified and saved. Your ledger is unchanged.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your email is verified and saved. Your ledger is unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"邮箱已验证并保存，原账本保持完整。"}}}},"Your email was updated, but the notification could not be delivered. Please contact support.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your email was updated, but the notification could not be delivered. Please contact support."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"邮箱已更新；通知投递失败，请联系支持。"}}}},"Your existing account and password still work. If SMS is unavailable or you are outside mainland China, register with email and sign in with a password.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your existing account and password still work. If SMS is unavailable or you are outside mainland China, register with email and sign in with a password."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原账号和原密码可继续登录。短信暂不可用或其他地区可使用邮箱注册与密码登录。"}}}},"Your password was changed and other sessions were signed out, but the email notification could not be delivered.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your password was changed and other sessions were signed out, but the email notification could not be delivered."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码已修改，其他旧会话已失效；邮件通知投递失败。"}}}},"Your password was changed. Other devices have been signed out.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your password was changed. Other devices have been signed out."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码已修改，其他设备的旧会话已失效。"}}}},"Your password was reset and your ledger is intact. All previous sessions have ended. Please sign in again.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your password was reset and your ledger is intact. All previous sessions have ended. Please sign in again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码已重置，原账本保留。所有旧会话已失效，请重新登录。"}}}},"Your request was accepted. Deletion is not complete. Expected: %@. Check its status here.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your request was accepted. Deletion is not complete. Expected: %@. Check its status here."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"申请已受理，尚未完成删除。预计 %@，可在此查询状态。"}}}},"Your watch syncs automatically after you sign in.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your watch syncs automatically after you sign in."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"登录后手表会自动同步"}}}},"accessoryCircular (Lock Screen)":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"accessoryCircular (Lock Screen)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"accessoryCircular（锁屏）"}}}},"accessoryInline (Lock Screen)":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"accessoryInline (Lock Screen)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"accessoryInline（锁屏）"}}}},"accessoryRectangular (Lock Screen)":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"accessoryRectangular (Lock Screen)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"accessoryRectangular（锁屏）"}}}},"minutes":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"minutes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分钟"}}}},"points":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"points"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分"}}}},"points · Welcome Bonus":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"points · Welcome Bonus"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分 · 贺礼"}}}},"the required tier":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"the required tier"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"指定等级"}}}},"usually within 30 days":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"usually within 30 days"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通常30天内"}}}},"wishes":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"wishes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"次心愿"}}}},"⌘R refreshes this app's ledger. A keyboard is required on iPhone and iPad. Turning this off keeps your preferences and touch controls available. System editing shortcuts are unchanged.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"⌘R refreshes this app's ledger. A keyboard is required on iPhone and iPad. Turning this off keeps your preferences and touch controls available. System editing shortcuts are unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"⌘R 只在本应用内刷新账本；iPhone、iPad 需连接键盘。关闭后保留设置，触屏刷新仍可用。系统编辑快捷键保持原样。"}}}},"📺 %lld minutes":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"📺 %lld minutes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"📺 %lld 分钟"}}}}},"version":"1.0"}
