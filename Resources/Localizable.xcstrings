t an item to restore it. Reorder the list using Edit or the arrow buttons.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archiving preserves past transactions. Edit an item to restore it. Reorder the list using Edit or the arrow buttons."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"归档保留历史，编辑可恢复；列表编辑或上下箭头调整常用顺序。"}}}},"Available":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Available"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可兑换"}}}},"Avatar":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Avatar"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"头像"}}}},"Avatar choices are temporarily unavailable. Please try again later.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Avatar choices are temporarily unavailable. Please try again later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务端没下发头像清单 —— 换个头像这一项暂时用不了"}}}},"Back to Sign In":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Back to Sign In"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"返回登录"}}}},"Balance":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Balance"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"总市值"}}}},"Balance after redemption":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Balance after redemption"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"兑换后余额"}}}},"Benefits depend on your **current** balance. Spending points may lower your tier and its benefits.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Benefits depend on your **current** balance. Spending points may lower your tier and its benefits."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解锁的东西按**当前**市值算 —— 花掉分掉了档，待遇也跟着回去。"}}}},"Brief description":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Brief description"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"简