<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 手表 app 与表盘复杂功能共享快照的仓（手表本机钥匙串，不跨设备）。第一项 = 不传
	     kSecAttrAccessGroup 时的默认落点，所以**两个手表 target 这一项必须逐字相同**；
	     与 iPhone 侧同名，Snapshot.swift 一个字不用改。 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)cyou.tianli.pointsdeck.shared</string>
	</array>
</dict>
</plist>
